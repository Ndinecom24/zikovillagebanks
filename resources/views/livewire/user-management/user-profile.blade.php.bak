        }

        .info-item .info-value {
            font-size: 0.92rem;
            color: #1e293b;
            font-weight: 600;
        }

        .info-item .info-value.empty {
            color: #cbd5e1;
            font-style: italic;
            font-weight: 400;
        }

        /* Edit form */
        .edit-field {
            margin-bottom: 1rem;
        }

        .edit-field label {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
