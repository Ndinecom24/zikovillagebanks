                    @forelse($licenses as $license)
                        @php
                            $daysLeft = $license->daysRemaining();
                            $isExpiringSoon = $license->status === 'active' && $daysLeft !== null && $daysLeft <= 14 && $daysLeft > 0;
                        @endphp
                        <tr class="{{ $isExpiringSoon ? 'table-warning' : '' }}">
                            <td>
                                <code style="font-size:0.85rem;">{{ $license->license_key }}</code>
                            </td>
                            <td>
                                @if($license->villageBank)
                                    <strong>{{ $license->villageBank->name }}</strong>
                                @else
                                    <span class="text-muted">—</span>
                                @endif
                            </td>
                            <td>
                                @if($license->subscription && $license->subscription->plan)
                                    <span class="badge bg-info text-dark">{{ $license->subscription->plan->name }}</span>
                                @else
                                    <span class="text-muted">—</span>
                                @endif
                            </td>
                            <td>
                                @if($license->status === 'active')
                                    <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Active</span>
                                @elseif($license->status === 'expired')
                                    <span class="badge bg-secondary"><i class="fas fa-clock me-1"></i>Expired</span>
                                @else
                                    <span class="badge bg-danger"><i class="fas fa-ban me-1"></i>Revoked</span>
                                @endif
                            </td>
                            <td><small>{{ $license->issued_at ? $license->issued_at->format('d M Y') : '—' }}</small></td>
                            <td><small>{{ $license->expires_at ? $license->expires_at->format('d M Y') : '—' }}</small></td>
                            <td>
                                @if($license->status === 'active' && $daysLeft !== null)
                                    @if($daysLeft <= 0)
                                        <span class="text-danger fw-bold">Expired</span>
                                    @elseif($daysLeft <= 14)
                                        <span class="text-warning fw-bold">{{ $daysLeft }} days</span>
                                    @else
                                        <span class="text-success">{{ $daysLeft }} days</span>
                                    @endif
                                @else
                                    <span class="text-muted">—</span>
                                @endif
                            </td>
                            <td class="text-end">
                                @if($license->status === 'active')
                                    <button wire:click="openRevoke({{ $license->id }})" class="z-action text-danger" title="Revoke">
