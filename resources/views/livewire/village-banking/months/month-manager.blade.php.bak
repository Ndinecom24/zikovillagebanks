                        </div>
                        <div class="modal-footer">
                            <button type="button" wire:click="$set('showAddModal', false)" class="btn btn-light" style="border-radius:8px;">Cancel</button>
                            <button type="submit" class="btn-zesco-green" wire:loading.attr="disabled" wire:target="addMonth">
                                <span wire:loading.remove wire:target="addMonth"><i class="fas fa-plus mr-1"></i> Add Month</span>
                                <span wire:loading wire:target="addMonth"><i class="fas fa-spinner fa-spin mr-1"></i> Adding...</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
