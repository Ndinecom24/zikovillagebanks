                                @php $totalVotes = $detailPoll->totalVotes(); @endphp
                                @foreach ($detailPoll->options as $option)
                                    @php
                                        $count = $option->votes->count();
                                        $pct = $totalVotes > 0 ? round(($count / $totalVotes) * 100, 1) : 0;
                                        $isWinner = $pct > 0 && $pct == collect($detailPoll->options)->max(fn($o) => $o->votes->count() > 0 ? round(($o->votes->count() / $totalVotes) * 100, 1) : 0);
                                    @endphp
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span style="font-weight:{{ $isWinner ? '700' : '500' }};font-size:0.9rem;">
                                                @if ($isWinner) <i class="fas fa-trophy mr-1" style="color:#f59e0b;"></i> @endif
                                                {{ $option->label }}
                                            </span>
                                            <span style="font-weight:600;font-size:0.88rem;color:#475569;">
                                                {{ $count }} vote{{ $count !== 1 ? 's' : '' }} ({{ $pct }}%)
                                            </span>
                                        </div>
                                        <div style="height:12px;background:#e2e8f0;border-radius:6px;overflow:hidden;">
                                            <div style="width:{{ $pct }}%;height:100%;background:{{ $isWinner ? 'var(--z-green)' : '#94a3b8' }};border-radius:6px;transition:width 0.3s;"></div>
                                        </div>
                                        {{-- Show voters if not anonymous --}}
                                        @if (!$detailPoll->is_anonymous && $option->votes->count() > 0)
                                            <div class="d-flex flex-wrap mt-1" style="gap:0.25rem;">
                                                @foreach ($option->votes as $vote)
                                                    <small class="badge" style="background:#f8fafc;color:#64748b;border-radius:4px;font-weight:500;padding:2px 6px;">
                                                        {{ $vote->voter->name ?? 'Unknown' }}
                                                    </small>
                                                @endforeach
                                            </div>
                                        @endif
                                    </div>
                                @endforeach
                            </div>
                        </div>

