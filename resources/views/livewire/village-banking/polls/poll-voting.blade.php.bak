                                @php $totalVotes = $currentPoll->totalVotes(); @endphp

                                @if ($totalVotes === 0)
                                    <p class="text-muted text-center py-3" style="font-size:0.88rem;">
                                        <i class="fas fa-chart-pie mr-1"></i> No votes yet.
                                    </p>
                                @else
                                    @foreach ($currentPoll->options as $option)
                                        @php
                                            $count = $option->votes->count();
                                            $pct = round(($count / $totalVotes) * 100, 1);
                                            $isTop = $count == $currentPoll->options->max(fn($o) => $o->votes->count());
                                        @endphp
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between mb-1">
                                                <span style="font-weight:{{ $isTop ? '700' : '500' }};font-size:0.88rem;">
                                                    @if ($isTop && $count > 0) <i class="fas fa-trophy" style="color:#f59e0b;font-size:0.78rem;"></i> @endif
                                                    {{ $option->label }}
                                                </span>
                                                <span style="font-weight:600;font-size:0.85rem;color:#475569;">{{ $pct }}%</span>
                                            </div>
                                            <div style="height:10px;background:#e2e8f0;border-radius:5px;overflow:hidden;">
                                                <div style="width:{{ $pct }}%;height:100%;background:{{ $isTop ? 'var(--z-green)' : '#94a3b8' }};border-radius:5px;transition:width 0.4s;"></div>
                                            </div>
                                            <small class="text-muted">{{ $count }} vote{{ $count !== 1 ? 's' : '' }}</small>
                                        </div>
                                    @endforeach
                                @endif

