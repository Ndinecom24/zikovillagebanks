                                        <td style="font-size:.78rem;color:var(--sd-faint);">{{ $idx + 1 }}</td>
                                        <td>
                                            <div class="sd-member-cell">
                                                @php
                                                    $parts = explode(' ', trim($m->name ?? ''));
