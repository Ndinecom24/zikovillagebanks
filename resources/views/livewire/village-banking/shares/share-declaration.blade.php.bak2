                                            </td>
                                        @endif
                                        <td>
                                            @php
                                                $shareAmt = is_numeric($shares[$m->id] ?? 0) ? (float)($shares[$m->id] ?? 0) : 0;
                                                $totalAmt = $shareAmt + ($insAmt ?? 0);
                                            @endphp
                                            <span style="font-weight:800;color:var(--sd-green);">{{ number_format($totalAmt, 2) }}</span>
