APP_NAME="Ziko Village Banking System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zikovillagebanks
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=your-domain.com
SANCTUM_TOKEN_EXPIRATION=480

CORS_ALLOWED_ORIGINS=https://your-domain.com

# Chilolezo SMS Gateway (optional)
CHILOLEZO_API_URL=
CHILOLEZO_API_KEY=
CHILOLEZO_SENDER_ID=

# MTN SMS v3 API (Zambia)
MTN_SMS_BASE_URL=https://api.mtn.com/v3/sms
MTN_SMS_TOKEN_URL="https://api.mtn.com/v1/oauth/access_token/accesstoken?grant_type=client_credentials"
MTN_SMS_CONSUMER_KEY=
MTN_SMS_CONSUMER_SECRET=
MTN_SMS_SENDER_ADDRESS=ZikoVB
MTN_SMS_SERVICE_CODE=
MTN_SMS_COUNTRY_CODE=260
MTN_SMS_DELIVERY_RECEIPT=false
